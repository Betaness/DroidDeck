+/* [mali-g2] The Mali driver keeps host memory for every render pass instance recorded into a command
+ * buffer that also records a query until the command buffer is reset with RELEASE_RESOURCES or its pool
+ * is destroyed (about 420 bytes per vkCmdBeginRendering, tests/frame_leak_test.c). DXVK resets its pools
+ * with flags 0, so a game issuing D3D11 queries grew the server by tens of MB a minute until malloc
+ * failed. Every VORTEK_CMD_RELEASE_EVERY-th reset of a pool or command buffer (default 32, 1 = every
+ * reset, 0 = never) releases. Implicit resets by vkBeginCommandBuffer are not covered. */
+static bool releaseCommandMemory(VkContext* context, uint64_t handle) {
+    static int every = -1;
+    if (every < 0) {
+        const char* value = getenv("VORTEK_CMD_RELEASE_EVERY");
+        int parsed = value && *value ? atoi(value) : 32;
+        if (value && *value) println("vortek: VORTEK_CMD_RELEASE_EVERY=%d", parsed);
+        every = parsed < 0 ? 0 : parsed;
+    }
+    if (every <= 1) return every == 1;
+    uint32_t slot = (uint32_t)((handle * 0x9E3779B97F4A7C15ull) >> 58);
+    if (context->commandResets[slot].handle != handle) {
+        context->commandResets[slot].handle = handle;
+        context->commandResets[slot].resets = 0;
+        return true;
+    }
+    if (++context->commandResets[slot].resets < (uint32_t)every) return false;
+    context->commandResets[slot].resets = 0;
+    return true;
+}
+
 void vt_handle_vkResetCommandPool(VkContext* context) {
     uint64_t deviceId;
     uint64_t commandPoolId;
@@ -1376,6 +1402,7 @@ void vt_handle_vkResetCommandPool(VkContext* context) {
     VkDevice device = VkObject_fromId(deviceId);
     VkCommandPool commandPool = VkObject_fromId(commandPoolId);
 
+    if (releaseCommandMemory(context, commandPoolId)) flags |= VK_COMMAND_POOL_RESET_RELEASE_RESOURCES_BIT;
     vulkanWrapper.vkResetCommandPool(device, commandPool, flags);
 }
 
@@ -1487,6 +1514,7 @@ void vt_handle_vkResetCommandBuffer(VkContext* context) {
     vt_unserialize_vkResetCommandBuffer((VkCommandBuffer)&commandBufferId, &flags, context->inputBuffer, &context->memoryPool);
     VkCommandBuffer commandBuffer = VkObject_fromId(commandBufferId);
 
+    if (releaseCommandMemory(context, commandBufferId)) flags |= VK_COMMAND_BUFFER_RESET_RELEASE_RESOURCES_BIT;
     vulkanWrapper.vkResetCommandBuffer(commandBuffer, flags);
 }
 
