+++ b/app/src/main/cpp/vortekrenderer/include/vk_context.h
@@ -53,6 +53,9 @@ typedef struct VkContext {
     pthread_mutex_t ownedLock;
     ArrayList ownedDevices;
     ArrayList ownedInstances;
+
+    /* [mali-g2] resets per command pool / command buffer since the last one that released its memory */
+    struct { uint64_t handle; uint32_t resets; } commandResets[64];
     int untrackedLogged;
 } VkContext;
 
