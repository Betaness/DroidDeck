diff --git a/src/ring_buffer.c b/src/ring_buffer.c
index 93a568f..b751c9c 100644
--- a/src/ring_buffer.c
+++ b/src/ring_buffer.c
@@ -176,6 +176,41 @@ bool RingBuffer_write(RingBuffer* ring, const void* data, uint32_t size) {
     return true;
 }
 
+/* [mali-g2] Writes two pieces (a request header and its payload) and publishes them with one tail
+ * store, so a sleeping reader is woken once per request: with separate writes the reader wakes for
+ * the header, spins SPIN_NS for the payload and, if the writer's wake syscall took longer than
+ * that, sleeps again and needs a second wake. That was measured under a proot whose kompat filter
+ * traps futex (about 38 us per wake); DroidDeck's guest proot does not trap futex (proot patch
+ * 0011), where a wake costs a few us and this mostly saves one syscall per request. */
+bool RingBuffer_write2(RingBuffer* ring, const void* a, uint32_t aSize, const void* b, uint32_t bSize) {
+    if (aSize + bSize > ring->bufferSize || aSize + bSize < aSize) {
+        return RingBuffer_write(ring, a, aSize) && (bSize == 0 || RingBuffer_write(ring, b, bSize));
+    }
+
+    if (!RingBuffer_waitForWrite(ring, aSize + bSize)) return false;
+    uint32_t tail = RingBuffer_getTail(ring);
+    const void* pieces[2] = {a, b};
+    uint32_t sizes[2] = {aSize, bSize};
+
+    for (int i = 0; i < 2; i++) {
+        uint32_t offset = tail & (ring->bufferSize - 1);
+        uint32_t size = sizes[i];
+        if (size == 0) continue;
+        if ((offset + size) <= ring->bufferSize) {
+            memcpy(ring->buffer + offset, pieces[i], size);
+        }
+        else {
+            uint32_t start = ring->bufferSize - offset;
+            memcpy(ring->buffer + offset, pieces[i], start);
+            memcpy(ring->buffer, (const char*)pieces[i] + start, size - start);
+        }
+        tail += size;
+    }
+
+    RingBuffer_setTail(ring, tail);
+    return true;
+}
