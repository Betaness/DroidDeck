diff --git a/src/vulkan_calls.c b/src/vulkan_calls.c
index 0453806..3aeefd3 100644
--- a/src/vulkan_calls.c
+++ b/src/vulkan_calls.c
@@ -28,6 +28,46 @@ static pthread_mutex_t vt_call_mutex = PTHREAD_MUTEX_INITIALIZER;
     pthread_mutex_unlock(&vt_call_mutex);
 
 #ifdef VORTEK_DROIDDECK
+#include "droiddeck_requests.h"
+
+/* [mali-g2] Command streaming (VT_CMD_STREAM in vortek.h). VORTEK_CMD_CHUNK=<bytes> (k/m suffixes
+ * allowed) sets the threshold; 0 sends every command buffer only at vkEndCommandBuffer. */
+int vt_cmdChunkSize = 0;
+
+__attribute__((constructor)) static void vt_initCmdChunkSize(void) {
+    const char* value = getenv("VORTEK_CMD_CHUNK");
+    if (!value || !*value) return;
+    /* parsed by hand: strtol would bind to glibc 2.38's __isoc23_strtol */
+    long size = 0;
+    const char* end = value;
+    while (*end >= '0' && *end <= '9' && size < (1L << 30)) size = size * 10 + (*end++ - '0');
+    if (*end == 'k' || *end == 'K') size *= 1024;
+    else if (*end == 'm' || *end == 'M') size *= 1024 * 1024;
+    /* a chunk must fit the server ring (larger requests take the socket path) */
+    if (size > SERVER_RING_BUFFER_SIZE / 4) size = SERVER_RING_BUFFER_SIZE / 4;
+    vt_cmdChunkSize = (int)size;
+}
+
+/* Sends the commands recorded so far (command buffer id, then the commands, the layout of
+ * END_COMMAND_BUFFER) and empties the batch, keeping the id. Called from VT_CMD_ENQUEUE, i.e. from
+ * vkCmd* functions, which never hold the call lock. No reply: like END, the server replays the
+ * chunk in request order. Everything in the batch is serialized by value, so nothing in it points
+ * into application memory.
+ * Recording never used to wait for the call lock, and another thread may hold it for a while (a
+ * vkAcquireNextImageKHR or vkQueueWaitIdle waiting in the server), so the lock is only tried: when
+ * it is busy the commands stay in the batch and the next vkCmd* tries again. Past 1 MiB the send
+ * waits for the lock, which keeps chunks well inside the server ring. */
+void vt_sendCommandChunk(CommandBatch* batch) {
+    if (batch->size <= VK_HANDLE_BYTE_COUNT) return;
+    if (batch->size < SERVER_RING_BUFFER_SIZE / 4) {
+        if (pthread_mutex_trylock(&vt_call_mutex) != 0) return;
+    }
+    else VT_CALL_LOCK();
+    vt_send(serverRing, REQUEST_CODE_DD_CMD_CHUNK, batch->buffer, batch->size);
+    VT_CALL_UNLOCK();
+    batch->size = VK_HANDLE_BYTE_COUNT;
+}
