+/* [mali-g2] Grow a batch geometrically: ENSURE_ARRAY_CAPACITY with an element size of 1 grows to
+ * exactly the requested size, i.e. a realloc (an mremap for large batches) for every command. */
+#if !defined(VT_SERVER) && defined(VORTEK_DROIDDECK)
+#define VT_CMD_RESERVE(batch, extra) \
+    do { \
+        int needed = (batch)->size + (extra); \
+        if (needed > (batch)->capacity) ENSURE_ARRAY_CAPACITY(needed + (needed >> 1) + 4096, (batch)->capacity, (batch)->buffer, 1); \
+    } \
+    while (0)
+#else
+#define VT_CMD_RESERVE(batch, extra) ENSURE_ARRAY_CAPACITY((batch)->size + (extra), (batch)->capacity, (batch)->buffer, 1)
