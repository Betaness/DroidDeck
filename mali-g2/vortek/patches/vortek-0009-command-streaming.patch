+
+/* [mali-g2] Command streaming: once a command buffer's batch reaches vt_cmdChunkSize bytes
+ * (VORTEK_CMD_CHUNK, off by default, e.g. 32k), the commands recorded so far are sent as a
+ * REQUEST_CODE_DD_CMD_CHUNK and the server replays them while the application keeps recording.
+ * vkCmd* functions run without the call lock; vt_sendCommandChunk takes it for the send only. */
+#if !defined(VT_SERVER) && defined(VORTEK_DROIDDECK)
+#define VT_CMD_STREAM(batch) \
+    do { \
+        if (vt_cmdChunkSize > 0 && (batch)->size >= vt_cmdChunkSize) vt_sendCommandChunk(batch); \
+    } \
+    while (0)
+#else
+#define VT_CMD_STREAM(batch) do {} while (0)
+#endif
