+/* Pipeline library lifetime (VK_KHR_pipeline_library). An application may destroy its
+ * libraries once a pipeline has been linked from them, but Mali's linked pipelines still use
+ * their libraries: a pipeline fast-linked from destroyed libraries draws nothing (natively it
+ * crashes). So every pipeline created with pLibraries holds a reference on each library, and
+ * vkDestroyPipeline on a library that is still referenced is deferred until the last pipeline
+ * linked from it is destroyed. Pipelines created without libraries are never entered here. */
+typedef struct LibraryRef {
+    struct LibraryRef* next;
+    VkDevice device;
+    VkPipeline pipeline;
+    uint32_t refCount;      /* existing pipelines linked from this one */
+    bool destroyPending;    /* destroyed by the client while refCount > 0 */
+    uint32_t libraryCount;  /* libraries this pipeline was linked from */
+    VkPipeline* libraries;
+} LibraryRef;
+
+#define LIBRARY_REF_BUCKETS 256
+static LibraryRef* libraryRefs[LIBRARY_REF_BUCKETS];
+static pthread_mutex_t libraryRefsMutex = PTHREAD_MUTEX_INITIALIZER;
+
+static LibraryRef** findLibraryRef(VkDevice device, VkPipeline pipeline) {
+    uint64_t key = (uint64_t)pipeline;
+    LibraryRef** link = &libraryRefs[(key ^ (key >> 12) ^ (key >> 24)) % LIBRARY_REF_BUCKETS];
+    while (*link && ((*link)->pipeline != pipeline || (*link)->device != device)) link = &(*link)->next;
+    return link;
+}
+
+static LibraryRef* getLibraryRef(VkDevice device, VkPipeline pipeline) {
+    LibraryRef** link = findLibraryRef(device, pipeline);
+    if (!*link) {
+        LibraryRef* ref = calloc(1, sizeof(LibraryRef));
+        if (!ref) return NULL;
+        ref->device = device;
+        ref->pipeline = pipeline;
+        *link = ref;
+    }
+    return *link;
+}
+
+static void removeLibraryRef(LibraryRef** link) {
+    LibraryRef* ref = *link;
+    *link = ref->next;
+    MEMFREE(ref->libraries);
+    MEMFREE(ref);
+}
+
+static void recordLinkedPipeline(VkDevice device, VkPipeline pipeline, const VkPipelineLibraryCreateInfoKHR* libraryInfo) {
+    pthread_mutex_lock(&libraryRefsMutex);
+    LibraryRef* ref = getLibraryRef(device, pipeline);
+    VkPipeline* libraries = ref ? calloc(libraryInfo->libraryCount, sizeof(VkPipeline)) : NULL;
+    if (libraries) {
+        ref->libraries = libraries;
+        for (uint32_t i = 0; i < libraryInfo->libraryCount; i++) {
+            LibraryRef* libraryRef = libraryInfo->pLibraries[i] ? getLibraryRef(device, libraryInfo->pLibraries[i]) : NULL;
+            if (!libraryRef) continue;
+            libraryRef->refCount++;
+            libraries[ref->libraryCount++] = libraryInfo->pLibraries[i];
+        }
+    }
+    pthread_mutex_unlock(&libraryRefsMutex);
+}
+
+/* Called with the mutex held, after the pipeline itself has been destroyed. */
+static void releaseLinkedPipeline(VkDevice device, VkPipeline pipeline) {
+    LibraryRef** link = findLibraryRef(device, pipeline);
+    if (!*link) return;
+    LibraryRef* ref = *link;
+    VkPipeline* libraries = ref->libraries;
+    uint32_t libraryCount = ref->libraryCount;
+    ref->libraries = NULL;
+    removeLibraryRef(link);
+
+    for (uint32_t i = 0; i < libraryCount; i++) {
