+++ b/app/src/main/cpp/vortekrenderer/src/async_pipeline_creator.c
@@ -2,6 +2,7 @@
 #include "vortek_serializer.h"
 #include "vulkan_helper.h"
 #include <pthread.h>
+#include <time.h>
 
 typedef struct PipelineCreateRequest {
     VkDevice device;
@@ -132,10 +133,41 @@ void AsyncPipelineCreator_destroyDevice(VkDevice device) {
     pthread_mutex_unlock(&libraryRefsMutex);
 }
 
+#ifdef VORTEK_STANDALONE
+static uint64_t pipelineNowNs(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+/* [mali-g2] The device's persistent implicit cache (src/pipeline_cache.c) when the application
+ * passes none (DXVK), except for calls that only fast-link libraries: those are cheap and would
+ * only fill the cache. */
+static VkPipelineCache choosePipelineCache(PipelineCreateRequest* request) {
+    if (request->pipelineCache) return request->pipelineCache;
+    if (request->type == PIPELINE_TYPE_GRAPHICS) {
+        const VkGraphicsPipelineCreateInfo* createInfos = request->pipelineInfos;
+        bool allFastLinks = true;
+        for (uint32_t i = 0; i < request->pipelineCount && allFastLinks; i++) allFastLinks = PipelineCache_isFastLink(&createInfos[i]);
+        if (allFastLinks) return VK_NULL_HANDLE;
+    }
+    return PipelineCache_get(request->device);
+}
+#endif
+
 static void pipelineCreateThread(void* param) {
     PipelineCreateRequest* pipelineCreateRequest = param;
     VkPipeline pipelines[pipelineCreateRequest->pipelineCount];
     VkResult result = VK_SUCCESS;
+#ifdef VORTEK_STANDALONE
+    VkPipelineCache implicitCache = VK_NULL_HANDLE;
+    uint64_t createStart = 0;
+    if (__atomic_load_n(&pipelineCreateRequest->context->status, __ATOMIC_ACQUIRE) >= 0) {
+        VkPipelineCache chosen = choosePipelineCache(pipelineCreateRequest);
+        if (chosen != pipelineCreateRequest->pipelineCache) implicitCache = pipelineCreateRequest->pipelineCache = chosen;
+        createStart = pipelineNowNs();
+    }
+#endif
 
     /* [mali-g2] the client is gone: nobody would get or destroy the pipelines (winlator-0015) */
     if (__atomic_load_n(&pipelineCreateRequest->context->status, __ATOMIC_ACQUIRE) < 0) {
@@ -171,6 +203,11 @@ static void pipelineCreateThread(void* param) {
         result = vulkanWrapper.vkCreateComputePipelines(pipelineCreateRequest->device, pipelineCreateRequest->pipelineCache, pipelineCreateRequest->pipelineCount, createInfos, NULL, pipelines);
     }
 
+#ifdef VORTEK_STANDALONE
+    if (createStart && result == VK_SUCCESS)
+        PipelineCache_noteCreated(pipelineCreateRequest->device, pipelineCreateRequest->pipelineCount, pipelineNowNs() - createStart, implicitCache != VK_NULL_HANDLE);
+#endif
+
     vt_free(&pipelineCreateRequest->memoryPool);
     ArrayList_free(&pipelineCreateRequest->memoryPool.allocationList, false);
 
