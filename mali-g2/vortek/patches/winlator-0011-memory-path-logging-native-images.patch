+static pthread_mutex_t optimalImagesLock = PTHREAD_MUTEX_INITIALIZER;
+static SparseArray64 optimalImages = {0}; /* key: VkImage, value: owning VkDevice */
+static uint32_t nativeImageAllocations = 0;
+static uint32_t nativeImageLive = 0;
+static uint64_t nativeImageBytesLive = 0;
+static uint64_t nativeImageBytesTotal = 0;
+
+void ResourceMemory_trackImage(VkDevice device, VkImage image, VkImageTiling tiling) {
+    if (!image || tiling != VK_IMAGE_TILING_OPTIMAL) return;
+    pthread_mutex_lock(&optimalImagesLock);
+    SparseArray64_put(&optimalImages, (int64_t)image, device);
+    pthread_mutex_unlock(&optimalImagesLock);
+}
+
+void ResourceMemory_untrackImage(VkImage image) {
+    if (!image) return;
+    pthread_mutex_lock(&optimalImagesLock);
+    SparseArray64_remove(&optimalImages, (int64_t)image);
+    pthread_mutex_unlock(&optimalImagesLock);
+}
+
+void ResourceMemory_untrackDevice(VkDevice device) {
+    pthread_mutex_lock(&optimalImagesLock);
+    for (int i = optimalImages.size - 1; i >= 0; i--) {
+        if (optimalImages.entries[i].value == (void*)device) SparseArray64_removeAt(&optimalImages, i);
+    }
+    pthread_mutex_unlock(&optimalImagesLock);
+}
+
+static bool isOptimalImage(VkImage image) {
+    pthread_mutex_lock(&optimalImagesLock);
+    bool found = SparseArray64_get(&optimalImages, (int64_t)image) != NULL;
+    pthread_mutex_unlock(&optimalImagesLock);
+    return found;
+}
