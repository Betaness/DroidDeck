+static VkResult allocateNativeImageMemory(VkContext* context, VkDevice device, VkMemoryAllocateInfo* memoryInfo, ResourceMemory* resourceMemory) {
+    /* Keep the client's memory type and rebuild pNext from copies of the structs that are
+     * safe to forward (dedicated image, allocate flags, opaque capture address): the driver
+     * gets a normal dedicated image allocation. Import/export structs never get here (see
+     * ResourceMemory_allocate), and a client fd number must never reach the driver.
+     * The memory is never exported, so vkMapMemory reports VK_ERROR_MEMORY_MAP_FAILED. */
+    VkMemoryDedicatedAllocateInfo dedicatedInfo = {0};
+    VkMemoryAllocateFlagsInfo flagsInfo = {0};
+    VkMemoryOpaqueCaptureAddressAllocateInfo captureInfo = {0};
+    void* pNext = NULL;
+
+    VkMemoryOpaqueCaptureAddressAllocateInfo* clientCapture = findNextVkStructure((void*)memoryInfo->pNext, VK_STRUCTURE_TYPE_MEMORY_OPAQUE_CAPTURE_ADDRESS_ALLOCATE_INFO);
+    if (clientCapture) {
+        captureInfo = *clientCapture;
+        captureInfo.pNext = pNext;
+        pNext = &captureInfo;
+    }
+    VkMemoryAllocateFlagsInfo* clientFlags = findNextVkStructure((void*)memoryInfo->pNext, VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO);
+    if (clientFlags) {
+        flagsInfo = *clientFlags;
+        flagsInfo.pNext = pNext;
+        pNext = &flagsInfo;
+    }
+    VkMemoryDedicatedAllocateInfo* clientDedicated = findNextVkStructure((void*)memoryInfo->pNext, VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO);
+    dedicatedInfo = *clientDedicated;
+    dedicatedInfo.pNext = pNext;
+    pNext = &dedicatedInfo;
+
+    VkMemoryAllocateInfo allocateInfo = *memoryInfo;
+    allocateInfo.pNext = pNext;
+    VkResult result = vulkanWrapper.vkAllocateMemory(device, &allocateInfo, NULL, &resourceMemory->memory);
+    logMemoryPath(MEMORY_PATH_NATIVE_IMAGE, result, memoryInfo->memoryTypeIndex, memoryInfo->memoryTypeIndex, memoryInfo->allocationSize);
+    if (result != VK_SUCCESS) return result;
+
+    resourceMemory->nativeImage = true;
+    pthread_mutex_lock(&optimalImagesLock);
+    uint32_t count = ++nativeImageAllocations;
+    nativeImageLive++;
+    nativeImageBytesLive += memoryInfo->allocationSize;
+    nativeImageBytesTotal += memoryInfo->allocationSize;
+    uint32_t live = nativeImageLive;
+    uint64_t bytesLive = nativeImageBytesLive, bytesTotal = nativeImageBytesTotal;
+    pthread_mutex_unlock(&optimalImagesLock);
+
+    if (count == 1 || (count % 64) == 0) {
+        println("vortek: native image allocations: %u total (%.1f MiB), %u live (%.1f MiB)",
+                count, bytesTotal / 1048576.0, live, bytesLive / 1048576.0);
+    }
+    return VK_SUCCESS;
+}
