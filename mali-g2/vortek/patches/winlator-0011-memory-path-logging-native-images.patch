+/* [mali-g2] Which allocation path ResourceMemory_allocate took. Each path is logged
+ * once per process (first success and first failure) so the logs show what the vendor
+ * driver actually accepts; the capability query alone does not tell. */
+enum {
+    MEMORY_PATH_OPAQUE_FD,
+    MEMORY_PATH_DMABUF,
+    MEMORY_PATH_AHB,
+    MEMORY_PATH_AHB_FALLBACK,
+    MEMORY_PATH_PLAIN,
+    MEMORY_PATH_NATIVE_IMAGE,
+    MEMORY_PATH_COUNT
+};
+
+static const char* const memoryPathNames[MEMORY_PATH_COUNT] = {
+    "opaque_fd (export)",
+    "dmabuf (import)",
+    "ahb (import, no dmabuf)",
+    "ahb fallback after dmabuf failure",
+    "plain (not host visible)",
+    "native image (plain, dedicated optimal image)"
+};
+
+static int memoryPathLogged[MEMORY_PATH_COUNT];
+static int memoryPathFailLogged[MEMORY_PATH_COUNT];
+
+static void memoryFlagsToString(uint32_t flags, char* out, size_t size) {
+    snprintf(out, size, "%s%s%s%s%s%s",
+             flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT ? "DL|" : "",
+             flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT ? "HV|" : "",
+             flags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT ? "HC|" : "",
+             flags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT ? "HCACHED|" : "",
+             flags & VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT ? "LAZY|" : "",
+             flags & VK_MEMORY_PROPERTY_PROTECTED_BIT ? "PROT|" : "");
+    size_t len = strlen(out);
+    if (len > 0) out[len - 1] = '\0';
+    else snprintf(out, size, "none");
+}
+
+static void logMemoryPath(int path, VkResult result, uint32_t requestedTypeIndex, uint32_t typeIndex, VkDeviceSize size) {
+    int* logged = result == VK_SUCCESS ? &memoryPathLogged[path] : &memoryPathFailLogged[path];
+    if (__atomic_exchange_n(logged, 1, __ATOMIC_RELAXED)) return;
+
+    char flags[64];
+    memoryFlagsToString(getMemoryPropertyFlags(typeIndex), flags, sizeof(flags));
+    if (result == VK_SUCCESS) {
+        println("vortek: memory path %s: first allocation ok, type %u (requested %u) flags 0x%x [%s], %llu bytes",
+                memoryPathNames[path], typeIndex, requestedTypeIndex, getMemoryPropertyFlags(typeIndex), flags, (unsigned long long)size);
+    }
+    else {
+        println("vortek: memory path %s: first FAILURE (VkResult %d), type %u (requested %u) flags 0x%x [%s], %llu bytes",
+                memoryPathNames[path], result, typeIndex, requestedTypeIndex, getMemoryPropertyFlags(typeIndex), flags, (unsigned long long)size);
+    }
+}
+
+/* ---- [mali-g2] VORTEK_NATIVE_IMAGES: optimal-tiling image set ---- */
