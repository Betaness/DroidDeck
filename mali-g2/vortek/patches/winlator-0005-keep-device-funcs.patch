+/* [mali-g2] One wrapper serves every client. Loading the functions of a device that left an
+ * extension disabled (zink's device has no VK_KHR_push_descriptor) must not clear the pointer
+ * another client's device still uses, or the server calls NULL and every client loses its device. */
+#ifdef VORTEK_STANDALONE
+#define VT_LOAD_DEVICE_FUNC(field, name) do { void* f_ = findVulkanDeviceFunc(vulkanWrapper, device, name); if (f_) vulkanWrapper->field = f_; } while (0)
+#else
+#define VT_LOAD_DEVICE_FUNC(field, name) (vulkanWrapper->field = findVulkanDeviceFunc(vulkanWrapper, device, name))
+#endif
+
