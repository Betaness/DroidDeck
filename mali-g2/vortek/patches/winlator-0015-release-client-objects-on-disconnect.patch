+/* Submits a fence-only batch on every queue of the device: its fence signals after all earlier work
+ * on that queue. vkDeviceWaitIdle has no timeout, and work that waits for a semaphore nobody will
+ * signal any more never finishes. */
+static void submitIdleFences(OwnedDevice* owned) {
+    VkDevice device = owned->device;
+    uint32_t queueCount = 0;
+    for (uint32_t i = 0; i < owned->queueInfoCount; i++) queueCount += owned->queueInfos[i].count;
+
+    owned->idleFences = calloc(queueCount ? queueCount : 1, sizeof(VkFence));
+    owned->idleFenceCount = 0;
+    for (uint32_t i = 0; i < owned->queueInfoCount; i++) {
+        for (uint32_t q = 0; q < owned->queueInfos[i].count; q++) {
+            VkQueue queue = VK_NULL_HANDLE;
+            if (owned->queueInfos[i].flags && vulkanWrapper.vkGetDeviceQueue2) {
+                VkDeviceQueueInfo2 queueInfo = {VK_STRUCTURE_TYPE_DEVICE_QUEUE_INFO_2, NULL, owned->queueInfos[i].flags, owned->queueInfos[i].family, q};
+                vulkanWrapper.vkGetDeviceQueue2(device, &queueInfo, &queue);
+            }
+            else if (!owned->queueInfos[i].flags) vulkanWrapper.vkGetDeviceQueue(device, owned->queueInfos[i].family, q, &queue);
+            if (!queue) continue;
+
+            VkFenceCreateInfo fenceInfo = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+            VkFence fence = VK_NULL_HANDLE;
+            if (vulkanWrapper.vkCreateFence(device, &fenceInfo, NULL, &fence) != VK_SUCCESS) continue;
+            VkResult result = vulkanWrapper.vkQueueSubmit(queue, 0, NULL, fence);
+            if (result != VK_SUCCESS) {
+                vulkanWrapper.vkDestroyFence(device, fence, NULL);
+                if (result == VK_ERROR_DEVICE_LOST) owned->lost = true;
+                continue;
+            }
+            owned->idleFences[owned->idleFenceCount++] = fence;
+        }
+    }
+}
+
+/* Waits at most timeoutNs for the fences of submitIdleFences. VK_TIMEOUT: still busy, the fences
+ * stay pending with the device. Otherwise the device runs nothing any more (idle, or lost) and may
+ * be destroyed. */
+static VkResult pollDeviceIdle(OwnedDevice* owned, uint64_t timeoutNs) {
+    VkDevice device = owned->device;
+    VkResult result = owned->idleFenceCount > 0 ? vulkanWrapper.vkWaitForFences(device, owned->idleFenceCount, owned->idleFences, VK_TRUE, timeoutNs) : VK_SUCCESS;
+    if (result == VK_TIMEOUT) return result;
+    for (uint32_t i = 0; i < owned->idleFenceCount; i++) vulkanWrapper.vkDestroyFence(device, owned->idleFences[i], NULL);
+    owned->idleFenceCount = 0;
+    MEMFREE(owned->idleFences);
+    if (result != VK_SUCCESS) owned->lost = true;
+    if (!owned->lost) vulkanWrapper.vkDeviceWaitIdle(device);
+    return result;
+}
+
+/* Work the client left waiting for a timeline value it was going to signal from the host never
+ * runs once the client is gone. Signalling every timeline semaphore of the device by the largest
+ * step the driver allows (no valid wait is further away) lets that work run and the device drain.
+ * Only done after the device failed to drain on its own: a later device signal of a lower value is
+ * out of spec, and the client that could observe it is gone. Returns how many were signalled. */
+static int signalTimelineSemaphores(OwnedDevice* owned) {
+    if (owned->timelineSemaphores.size == 0 || !vulkanWrapper.vkSignalSemaphore || !vulkanWrapper.vkGetSemaphoreCounterValue) return 0;
+
+    VkPhysicalDeviceTimelineSemaphoreProperties timelineProperties = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_PROPERTIES};
+    VkPhysicalDeviceProperties2 properties = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &timelineProperties};
+    if (owned->physicalDevice && vulkanWrapper.vkGetPhysicalDeviceProperties2) vulkanWrapper.vkGetPhysicalDeviceProperties2(owned->physicalDevice, &properties);
+    uint64_t maxDifference = timelineProperties.maxTimelineSemaphoreValueDifference;
+    if (maxDifference == 0) maxDifference = INT32_MAX; /* the minimum the spec requires */
+
+    int signalled = 0;
+    OwnedSet* set = &owned->timelineSemaphores;
+    for (uint32_t i = 0; i < set->capacity; i++) {
+        VkSemaphore semaphore = (VkSemaphore)set->keys[i];
+        uint64_t value;
+        if (!semaphore || vulkanWrapper.vkGetSemaphoreCounterValue(owned->device, semaphore, &value) != VK_SUCCESS) continue;
+        uint64_t target = value > UINT64_MAX - maxDifference ? UINT64_MAX : value + maxDifference;
+        if (target == value) continue;
+        VkSemaphoreSignalInfo signalInfo = {VK_STRUCTURE_TYPE_SEMAPHORE_SIGNAL_INFO, NULL, semaphore, target};
+        if (vulkanWrapper.vkSignalSemaphore(owned->device, &signalInfo) == VK_SUCCESS) signalled++;
+    }
+    return signalled;
+}
+
+#define RELEASE_IDLE_TIMEOUT_NS 3000000000ull      /* the client's last work finishes on its own */
+#define RELEASE_UNBLOCKED_TIMEOUT_NS 1000000000ull /* after its timeline semaphores were signalled */
+
+static void logReleased(VkContext* context, const ReleaseStats* stats, const char* prefix, const char* suffix) {
+    char unblocked[64] = "";
+    if (stats->timelinesSignalled > 0) snprintf(unblocked, sizeof(unblocked), ", %d timeline semaphores signalled", stats->timelinesSignalled);
+    println("vortek-server: %s (fd=%d): released %d devices, %d memory allocations (%.1f MiB), %d swapchains, %d other objects, %d instances%s%s",
+            prefix, context->clientFd, stats->devices, stats->objects[OWNED_MEMORY], stats->memoryBytes / 1048576.0, stats->objects[OWNED_SWAPCHAIN],
+            countOwnedObjects(stats) - stats->objects[OWNED_MEMORY] - stats->objects[OWNED_SWAPCHAIN], stats->instances, unblocked, suffix);
+}
+
+static void destroyOwnedInstances(VkContext* context, ReleaseStats* stats) {
+    for (int i = 0; i < context->ownedInstances.size; i++) {
+        vulkanWrapper.vkDestroyInstance(context->ownedInstances.elements[i], NULL);
+        stats->instances++;
+    }
+    ArrayList_free(&context->ownedInstances, false);
+}
+
+/* The client is gone (exit, crash, SIGKILL) and its request thread and thread pool have ended:
+ * destroy every device it did not destroy with everything it left on them, then its instances.
+ * Devices still busy stay in context->ownedDevices (with their pending idle fences) and the
+ * instances with them; returns whether everything was released. */
+static bool releaseOwnedObjects(VkContext* context) {
+    ReleaseStats stats = {0};
+    ArrayList busy = {0};
+
+    for (int i = 0; i < context->ownedDevices.size; i++) submitIdleFences(context->ownedDevices.elements[i]);
+
+    uint64_t deadline = releaseNowNs() + RELEASE_IDLE_TIMEOUT_NS;
+    for (int i = 0; i < context->ownedDevices.size; i++) {
+        OwnedDevice* owned = context->ownedDevices.elements[i];
+        uint64_t now = releaseNowNs();
+        VkResult result = pollDeviceIdle(owned, deadline > now ? deadline - now : 0);
+        if (result == VK_TIMEOUT) {
+            int signalled = signalTimelineSemaphores(owned);
+            stats.timelinesSignalled += signalled;
+            if (signalled > 0) result = pollDeviceIdle(owned, RELEASE_UNBLOCKED_TIMEOUT_NS);
+        }
+        if (result == VK_TIMEOUT) {
+            println("vortek: client gone (fd=%d): device %p still busy after %llu ms (%u memory allocations, %u timeline semaphores), released in the background when it drains",
+                    context->clientFd, owned->device, RELEASE_IDLE_TIMEOUT_NS / 1000000, owned->objects[OWNED_MEMORY].size, owned->timelineSemaphores.size);
+            ArrayList_add(&busy, owned);
+            continue;
+        }
+        releaseDevice(context, owned, &stats);
+        freeOwnedDevice(owned);
+    }
+    ArrayList_free(&context->ownedDevices, false);
+    context->ownedDevices = busy;
+
+    if (busy.size == 0) destroyOwnedInstances(context, &stats);
+
+    char suffix[64] = "";
+    if (busy.size > 0) snprintf(suffix, sizeof(suffix), " (%d busy devices left to the background cleanup)", busy.size);
+    logReleased(context, &stats, "client gone", suffix);
+    return busy.size == 0;
+}
+
+static void freeVkContext(VkContext* context);
+
+/* A device of a gone client that did not drain in time (its last work runs long, waits for a GPU
+ * reset, or for a semaphore nobody signals): poll its idle fences until it drains or is lost, then
+ * release it like releaseOwnedObjects would have, and finally the instances and the context. */
+static void* releaseBusyDevicesThread(void* param) {
+    VkContext* context = param;
+    uint64_t start = releaseNowNs();
+    ReleaseStats stats = {0};
+
+    while (context->ownedDevices.size > 0) {
+        uint64_t sliceNs = releaseNowNs() - start < 60000000000ull ? 1000000000ull : 10000000000ull;
+        for (int i = context->ownedDevices.size - 1; i >= 0; i--) {
+            OwnedDevice* owned = context->ownedDevices.elements[i];
+            if (pollDeviceIdle(owned, sliceNs / context->ownedDevices.size) == VK_TIMEOUT) continue;
+            ArrayList_removeAt(&context->ownedDevices, i);
+            releaseDevice(context, owned, &stats);
+            freeOwnedDevice(owned);
+        }
+    }
+    ArrayList_free(&context->ownedDevices, false);
+    destroyOwnedInstances(context, &stats);
+
+    char prefix[64];
+    snprintf(prefix, sizeof(prefix), "client gone, busy devices drained after %.1f s", (releaseNowNs() - start) / 1e9);
+    logReleased(context, &stats, prefix, "");
+    freeVkContext(context);
+    return NULL;
+}
