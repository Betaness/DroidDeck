+void VkContext_trackTimelineSemaphore(VkContext* context, VkDevice device, VkSemaphore semaphore) {
+    if (!semaphore) return;
+    pthread_mutex_lock(&context->ownedLock);
+    OwnedDevice* owned = findOwnedDevice(context, device, NULL);
+    if (owned) ownedSetAdd(&owned->timelineSemaphores, (uint64_t)semaphore);
+    pthread_mutex_unlock(&context->ownedLock);
