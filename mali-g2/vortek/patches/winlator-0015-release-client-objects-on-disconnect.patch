+/* [mali-g2] Objects of one VkDevice that the client has not destroyed (winlator-0015). The Mali
+ * driver does not reclaim children on vkDestroyDevice (fences keep imported sync files, pools and
+ * pipelines their GPU mappings), and the server keeps its own state for some (ResourceMemory fds,
+ * dma-bufs and AHardwareBuffers, swapchains, shader module SPIR-V), so when the client is gone they
+ * are destroyed one by one, in this order, before the device. Client processes have one connection
+ * each and ids are only valid on the connection that returned them, so ownership is per context.
+ * Command buffers and descriptor sets go with their pools. Guarded by ownedLock (pipelines are
+ * created on the thread pool). */
+typedef enum OwnedKind {
+    OWNED_FRAMEBUFFER,
+    OWNED_IMAGE_VIEW,
+    OWNED_BUFFER_VIEW,
+    OWNED_PIPELINE,
+    OWNED_SHADER_MODULE,
+    OWNED_PIPELINE_LAYOUT,
+    OWNED_DESCRIPTOR_POOL,
+    OWNED_DESCRIPTOR_SET_LAYOUT,
+    OWNED_SAMPLER,
+    OWNED_SAMPLER_YCBCR_CONVERSION,
+    OWNED_RENDER_PASS,
+    OWNED_PIPELINE_CACHE,
+    OWNED_QUERY_POOL,
+    OWNED_EVENT,
+    OWNED_SEMAPHORE,
+    OWNED_FENCE,
+    OWNED_COMMAND_POOL,
+    OWNED_SWAPCHAIN, /* after the views and framebuffers the client made of its images */
+    OWNED_BUFFER,
+    OWNED_IMAGE,
+    OWNED_MEMORY,
+    OWNED_KIND_COUNT
+} OwnedKind;
+
+typedef struct OwnedSet {
+    uint64_t* keys; /* open addressing, 0 = empty */
+    uint32_t capacity;
+    uint32_t size;
+} OwnedSet;
+
+typedef struct OwnedQueue {
+    uint32_t family;
+    uint32_t count;
+    VkDeviceQueueCreateFlags flags;
+} OwnedQueue;
+
+typedef struct OwnedDevice {
+    VkDevice device;
+    VkPhysicalDevice physicalDevice;
+    uint32_t queueInfoCount;
+    OwnedQueue* queueInfos;
+    OwnedSet objects[OWNED_KIND_COUNT];
+    OwnedSet timelineSemaphores; /* the timeline ones of objects[OWNED_SEMAPHORE] */
+    VkFence* idleFences;         /* pending fence-only submits while the device drains */
+    uint32_t idleFenceCount;
+    bool lost;
+} OwnedDevice;
+
