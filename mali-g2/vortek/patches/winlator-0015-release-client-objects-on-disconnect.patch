+static uint32_t ownedHash(uint64_t key) {
+    key ^= key >> 33;
+    key *= 0xff51afd7ed558ccdull;
+    key ^= key >> 33;
+    return (uint32_t)key;
+}
+
+static uint32_t ownedSetFind(const OwnedSet* set, uint64_t key) {
+    uint32_t mask = set->capacity - 1;
+    uint32_t i = ownedHash(key) & mask;
+    while (set->keys[i] && set->keys[i] != key) i = (i + 1) & mask;
+    return i;
+}
+
+static void ownedSetAdd(OwnedSet* set, uint64_t key) {
+    if ((set->size + 1) * 4 > set->capacity * 3) {
+        OwnedSet grown = {calloc(set->capacity ? set->capacity * 2 : 16, sizeof(uint64_t)), set->capacity ? set->capacity * 2 : 16, set->size};
+        for (uint32_t i = 0; i < set->capacity; i++) {
+            if (set->keys[i]) grown.keys[ownedSetFind(&grown, set->keys[i])] = set->keys[i];
+        }
+        free(set->keys);
+        *set = grown;
+    }
+    uint32_t i = ownedSetFind(set, key);
+    if (!set->keys[i]) {
+        set->keys[i] = key;
+        set->size++;
+    }
+}
+
+static bool ownedSetRemove(OwnedSet* set, uint64_t key) {
+    if (set->size == 0) return false;
+    uint32_t mask = set->capacity - 1;
+    uint32_t i = ownedSetFind(set, key);
+    if (!set->keys[i]) return false;
+    set->keys[i] = 0;
+    set->size--;
+    /* backward shift: entries after the hole that probed past it move into it */
+    for (uint32_t j = (i + 1) & mask; set->keys[j]; j = (j + 1) & mask) {
+        uint32_t home = ownedHash(set->keys[j]) & mask;
+        bool reachable = i <= j ? (i < home && home <= j) : (i < home || home <= j);
+        if (reachable) continue;
+        set->keys[i] = set->keys[j];
+        set->keys[j] = 0;
+        i = j;
+    }
+    return true;
+}
+
+static void ownedSetFree(OwnedSet* set) {
+    MEMFREE(set->keys);
+    set->capacity = set->size = 0;
+}
