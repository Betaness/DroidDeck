+void VkContext_track(VkContext* context, VkDevice device, OwnedKind kind, void* object) {
+    if (!object) return;
+    pthread_mutex_lock(&context->ownedLock);
+    OwnedDevice* owned = findOwnedDevice(context, device, NULL);
+    if (owned) ownedSetAdd(&owned->objects[kind], (uint64_t)object);
+    else logNotOwned(context, "device", device);
+    pthread_mutex_unlock(&context->ownedLock);
