+static void logNotOwned(VkContext* context, const char* what, void* object) {
+    if (context->untrackedLogged >= 8) return;
+    context->untrackedLogged++;
+    println("vortek: %s %p is not owned by this connection (fd=%d), not destroyed (untracked)", what, object, context->clientFd);
