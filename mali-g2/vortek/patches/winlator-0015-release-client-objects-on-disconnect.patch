+void VkContext_addDevice(VkContext* context, VkPhysicalDevice physicalDevice, VkDevice device, const VkDeviceCreateInfo* createInfo) {
+    if (!device) return;
+    OwnedDevice* owned = calloc(1, sizeof(OwnedDevice));
+    owned->device = device;
+    owned->physicalDevice = physicalDevice;
