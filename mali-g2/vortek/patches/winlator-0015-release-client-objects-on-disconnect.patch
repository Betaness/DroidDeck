+static OwnedDevice* findOwnedDevice(VkContext* context, VkDevice device, int* pIndex) {
+    for (int i = 0; i < context->ownedDevices.size; i++) {
+        OwnedDevice* owned = context->ownedDevices.elements[i];
+        if (owned->device == device) {
+            if (pIndex) *pIndex = i;
+            return owned;
+        }
+    }
+    return NULL;
+}
