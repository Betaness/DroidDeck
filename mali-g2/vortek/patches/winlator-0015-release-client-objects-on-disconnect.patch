+        for (uint32_t i = 0; i < set->capacity; i++) {
+            if (set->keys[i]) destroyOwned(context, device, kind, (void*)set->keys[i], stats);
+        }
+        ownedSetFree(set);
+    }
+    ownedSetFree(&owned->timelineSemaphores);
+    if (stats) stats->devices++;
