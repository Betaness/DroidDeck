+        owned->queueInfos = calloc(createInfo->queueCreateInfoCount, sizeof(OwnedQueue));
+        for (uint32_t i = 0; i < createInfo->queueCreateInfoCount; i++) {
+            owned->queueInfos[i].family = createInfo->pQueueCreateInfos[i].queueFamilyIndex;
+            owned->queueInfos[i].count = createInfo->pQueueCreateInfos[i].queueCount;
+            owned->queueInfos[i].flags = createInfo->pQueueCreateInfos[i].flags;
+        }
+        owned->queueInfoCount = createInfo->queueCreateInfoCount;
