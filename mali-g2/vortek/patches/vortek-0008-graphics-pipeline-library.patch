+static inline void vt_unserialize_VkGraphicsPipelineLibraryCreateInfoEXT(VkGraphicsPipelineLibraryCreateInfoEXT* val, char* inputBuffer, MemoryPool* memoryPool) {
+    int bufferOffset = 0;
