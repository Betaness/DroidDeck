+
+static inline int vt_sizeof_VkPipelineLibraryCreateInfoKHR(VkPipelineLibraryCreateInfoKHR* val) {
+    int bufferSize = 0;
+    bufferSize += 4; // sType
+    bufferSize += 4; // libraryCount
+    bufferSize += 4;
+    if (val->pLibraries) {
+        for (int i = 0; i < val->libraryCount; i++) {
+            bufferSize += vt_sizeof_VkPipeline(val->pLibraries[i]);
+        }
+    }
+    return bufferSize;
+}
+
+static inline void vt_serialize_VkPipelineLibraryCreateInfoKHR(VkPipelineLibraryCreateInfoKHR* val, char* outputBuffer) {
+    int bufferOffset = 0;
+    *(VkStructureType*)(outputBuffer + bufferOffset) = val->sType;
+    bufferOffset += 4;
+    *(uint32_t*)(outputBuffer + bufferOffset) = val->libraryCount;
+    bufferOffset += 4;
+
+    if (val->pLibraries) {
+        *(int*)(outputBuffer + bufferOffset) = val->libraryCount;
+        bufferOffset += 4;
+        for (int i = 0; i < val->libraryCount; i++) {
+#ifdef VT_SERVER
+            vt_serialize_VkPipeline(val->pLibraries[i], outputBuffer + bufferOffset);
+#else
+            VkObject* librariesObject = VkObject_fromHandle(val->pLibraries[i]);
+            vt_serialize_VkPipeline((VkPipeline)&librariesObject->id, outputBuffer + bufferOffset);
+#endif
+            bufferOffset += vt_sizeof_VkPipeline(val->pLibraries[i]);
+        }
+    }
+    else {
+        *(int*)(outputBuffer + bufferOffset) = 0;
+        bufferOffset += 4;
+    }
+}
+
+static inline void vt_unserialize_VkPipelineLibraryCreateInfoKHR(VkPipelineLibraryCreateInfoKHR* val, char* inputBuffer, MemoryPool* memoryPool) {
+    int bufferOffset = 0;
+    val->sType = *(VkStructureType*)(inputBuffer + bufferOffset);
+    bufferOffset += 4;
+#ifdef VT_SERVER
+    val->pNext = NULL;
+#endif
+    val->libraryCount = *(uint32_t*)(inputBuffer + bufferOffset);
+    bufferOffset += 4;
+
+    int dataSize2 = *(int*)(inputBuffer + bufferOffset);
+    bufferOffset += 4;
+    if (dataSize2 > 0) {
+        VkPipeline* arrValues = vt_alloc(memoryPool, dataSize2 * sizeof(VkPipeline));
+        for (int i = 0; i < dataSize2; i++) {
+            uint64_t librariesId;
+            vt_unserialize_VkPipeline((VkPipeline)&librariesId, inputBuffer + bufferOffset, memoryPool);
+            if (arrValues) {
+#ifdef VT_SERVER
+                arrValues[i] = VkObject_fromId(librariesId);
+#else
+                VkObject* librariesObject = VkObject_create(VK_OBJECT_TYPE_PIPELINE, librariesId);
+                arrValues[i] = VkObject_toHandle(librariesObject);
+#endif
+                bufferOffset += vt_sizeof_VkPipeline(arrValues[i]);
+            }
+            else bufferOffset += vt_sizeof_VkPipeline(VK_NULL_HANDLE);
+        }
+        val->pLibraries = arrValues;
+    }
+    else val->pLibraries = NULL;
+}
