+/* [mali-g2] Sends a DroidDeck request (droiddeck_requests.h) and returns the server's VkResult. */
+int droiddeck_request(int requestCode, const void* payload, int size) {
+    VT_CALL_LOCK();
+    int bytesSent = vt_send(serverRing, requestCode, (void*)payload, size);
+    int result = VK_ERROR_DEVICE_LOST;
+    if (bytesSent == size) {
+        char* inputBuffer = NULL;
+        result = vt_recv(clientRing, &inputBuffer, NULL, &globalMemoryPool);
+    }
+    VT_CALL_UNLOCK();
+    return result;
+}
