+/* Spin briefly (most replies arrive within microseconds), then sleep on `word` until the other
+ * side changes it. Announcing the waiter before the final check pairs with the writer storing the
+ * word before reading the waiter count (both seq_cst), so a wakeup cannot be missed; the timeout
+ * only bounds how long an EXIT that raced the announcement goes unseen. */
+static bool waitUntil(RingBuffer* ring, atomic_uint* word, atomic_uint* waiters, bool (*ready)(RingBuffer*, uint32_t), uint32_t size) {
+    if (ready(ring, size)) return true;
+    int64_t spinUntil = monotonicNs() + SPIN_NS;
+    uint32_t iter = 0;
+    while (monotonicNs() < spinUntil) {
+        for (int i = 0; i < 32; i++) cpuRelax();
+        if (ready(ring, size)) return true;
+        if ((++iter & 63) == 0 && RingBuffer_hasStatus(ring, RING_STATUS_EXIT)) return false;
+    }
