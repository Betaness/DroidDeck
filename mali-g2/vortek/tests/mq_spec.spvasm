; Spec-constant composites read by a compute shader (mali_quirks_test.c).
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main"
               OpExecutionMode %main LocalSize 1 1 1
               OpDecorate %sb0 SpecId 0
               OpDecorate %sb1 SpecId 1
               OpDecorate %sb2 SpecId 2
               OpDecorate %sb3 SpecId 3
               OpDecorate %si0 SpecId 4
               OpDecorate %si1 SpecId 5
               OpDecorate %si2 SpecId 6
               OpDecorate %si3 SpecId 7
               OpDecorate %rt ArrayStride 16
               OpDecorate %arr2 ArrayStride 16
               OpDecorate %Out Block
               OpMemberDecorate %Out 0 Offset 0
               OpDecorate %buf DescriptorSet 0
               OpDecorate %buf Binding 0
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
       %bool = OpTypeBool
        %int = OpTypeInt 32 1
       %uint = OpTypeInt 32 0
     %v4bool = OpTypeVector %bool 4
      %v4int = OpTypeVector %int 4
         %u2 = OpConstant %uint 2
       %arr2 = OpTypeArray %v4int %u2
         %rt = OpTypeRuntimeArray %v4int
        %Out = OpTypeStruct %rt
       %pOut = OpTypePointer StorageBuffer %Out
       %pv4i = OpTypePointer StorageBuffer %v4int
        %buf = OpVariable %pOut StorageBuffer
        %sb0 = OpSpecConstantFalse %bool
        %sb1 = OpSpecConstantTrue %bool
        %sb2 = OpSpecConstantFalse %bool
        %sb3 = OpSpecConstantTrue %bool
        %si0 = OpSpecConstant %int 1
        %si1 = OpSpecConstant %int 2
        %si2 = OpSpecConstant %int 3
        %si3 = OpSpecConstant %int 4
       %cond = OpConstantComposite %v4bool %sb0 %sb1 %sb2 %sb3
       %ivec = OpConstantComposite %v4int %si0 %si1 %si2 %si3
         %i0 = OpConstant %int 0
         %i1 = OpConstant %int 1
         %i2 = OpConstant %int 2
         %i3 = OpConstant %int 3
        %i11 = OpConstant %int 11
        %i22 = OpConstant %int 22
        %i33 = OpConstant %int 33
        %i44 = OpConstant %int 44
        %i99 = OpConstant %int 99
         %im = OpConstant %int -1
          %a = OpConstantComposite %v4int %i11 %i22 %i33 %i44
          %z = OpConstantComposite %v4int %i0 %i0 %i0 %i0
       %nest = OpConstantComposite %arr2 %ivec %a
        %s99 = OpConstantComposite %v4int %i99 %i99 %i99 %i99
         %sm = OpConstantComposite %v4int %im %im %im %im
       %main = OpFunction %void None %fn
      %entry = OpLabel
         %r0 = OpSelect %v4int %cond %a %z
         %p0 = OpAccessChain %pv4i %buf %i0 %i0
               OpStore %p0 %r0
         %p1 = OpAccessChain %pv4i %buf %i0 %i1
               OpStore %p1 %ivec
         %r2 = OpCompositeExtract %v4int %nest 0
         %p2 = OpAccessChain %pv4i %buf %i0 %i2
               OpStore %p2 %r2
        %r3s = OpSelect %int %sb0 %i99 %im
         %r3 = OpCompositeConstruct %v4int %r3s %r3s %r3s %r3s
         %p3 = OpAccessChain %pv4i %buf %i0 %i3
               OpStore %p3 %r3
               OpReturn
               OpFunctionEnd
